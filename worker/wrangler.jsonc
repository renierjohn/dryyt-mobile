{
	"name": "dryyt-worker",
	"main": "src/index.ts",
	// Landing page (web/, built with `bun run web:build`). Only exact file paths are served from here; everything else goes to the API.
	"assets": { "directory": "./web/dist", "not_found_handling": "none" },
	// Landing page, legal pages and cpanel on the main domain; the API stays on *.workers.dev too.
	"routes": [
		{ "pattern": "dryyt.com", "custom_domain": true },
		{ "pattern": "www.dryyt.com", "custom_domain": true }
	],
	"workers_dev": true,
	"compatibility_date": "2025-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Checks Expo push receipts (lib/push.ts checkPushReceipts).
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"vars": {
		"DELIVERY_FEE": "5000",
		// Pickup (food/laundry from a store to the customer): "true" serves /orders, /jobs and /menu; "false" refuses them with 403.
		"PICKUP_ENABLED": "true",
		"OSRM_URL": "https://router.project-osrm.org",
		// Identifies the app (not the user) to the routing server; public OSRM drops requests without one.
		"OSRM_USER_AGENT": "dryyt-worker/1.0 (+https://dryyt.com)",
		// Fallback when OSRM fails; needs the ORS_API_KEY secret (.dev.vars locally, `wrangler secret put` deployed).
		"ORS_URL": "https://api.openrouteservice.org",
		// Frontend hostnames the cpanel Turnstile check accepts; TURNSTILE_SECRET is a secret (`wrangler secret put`).
		"TURNSTILE_HOSTNAMES": "dryyt.com,www.dryyt.com",
		// Firebase project whose Auth ID tokens /auth/firebase accepts (Google sign-in in the app).
		"FIREBASE_PROJECT_ID": "dryyt-7b40a"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DISPATCH",
				"class_name": "Dispatch"
			},
			{
				"name": "TRIP",
				"class_name": "Trip"
			},
			{
				"name": "PICKUPS",
				"class_name": "PickupBoard"
			},
			{
				"name": "ORDER_ROOM",
				"class_name": "OrderRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Dispatch"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Trip"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"PickupBoard",
				"OrderRoom"
			]
		}
	],
	"r2_buckets": [
		{
			"binding": "PROOFS",
			"bucket_name": "dryyt-mobile"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dryyt-mobile",
			"database_id": "5554bba6-a382-4a69-8034-7df6e97bd9ce",
			"migrations_dir": "migrations"
		}
	]
}