{
  "name": "dryyt-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.js",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "deploy": "bun run web:build && wrangler deploy",
    "deploy:preview": "bun run web:build && wrangler deploy --env preview",
    "r2:lifecycle": "wrangler r2 bucket lifecycle add dryyt-mobile expire-proofs proof/ --expire-days 90 -y && wrangler r2 bucket lifecycle add dryyt-mobile expire-payments payments/ --expire-days 90 -y",
    "r2:lifecycle:preview": "wrangler r2 bucket lifecycle add dryyt-mobile-preview expire-proofs proof/ --expire-days 90 -y && wrangler r2 bucket lifecycle add dryyt-mobile-preview expire-payments payments/ --expire-days 90 -y",
    "test": "vitest run && vitest run -c vitest.v2.config.ts",
    "test:v2": "vitest run -c vitest.v2.config.ts",
    "typecheck": "tsc --noEmit",
    "stores": "bun scripts/list-stores.js",
    "users": "bun scripts/list-users.js",
    "shop:set": "bun scripts/set-shop.js",
    "user:add": "bun scripts/add-user.js",
    "user:set": "bun scripts/set-user.js",
    "driver:verify": "bun scripts/verify-driver.js",
    "admin:set": "bun scripts/set-admin.js",
    "mock:customer": "bun scripts/dropoff/mock-customer.js",
    "mock:driver": "bun scripts/dropoff/mock-driver.js",
    "mock:standby": "bun scripts/dropoff/mock-driver-standby.js",
    "mock:owner": "bun scripts/dropoff/mock-owner.js",
    "mock:driver-owner-dropoff": "bun scripts/dropoff/mock-driver-owner.js",
    "mock:customer-owner-dropoff": "bun scripts/dropoff/mock-customer-owner.js",
    "mock:customer-driver-dropoff": "bun scripts/dropoff/mock-customer-driver.js",
    "mock:store-owner": "bun scripts/pickup-food/mock-store-owner.js",
    "mock:customer-driver-pickup-food": "bun scripts/pickup-food/mock-customer-driver-pickup-food.js",
    "mock:driver-owner-pickup-food": "bun scripts/pickup-food/mock-driver-owner.js",
    "mock:driver-pickup-laundry": "bun scripts/pickup-laundry/mock-driver-pickup-laundry.js",
    "mock:driver-owner-pickup-laundry": "bun scripts/pickup-laundry/mock-driver-owner.js",
    "mock:push": "bun scripts/mock-push.js",
    "db:migrate:local": "wrangler d1 migrations apply dryyt-mobile --local",
    "db:migrate:remote": "wrangler d1 migrations apply dryyt-mobile --remote",
    "db:migrate:preview": "wrangler d1 migrations apply dryyt-mobile-preview --remote --env preview"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^5.20261009.1",
    "typescript": "^7.0.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.149.0"
  }
}
