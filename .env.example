# iOS simulator: http://localhost:8788
# Android emulator: http://10.0.2.2:8788
# Physical device: http://<your-computer-LAN-IP>:8788
EXPO_PUBLIC_API_URL=http://localhost:8788
# Google sign-in: the Firebase project's Web client ID (Firebase console → Authentication → Sign-in method → Google → Web SDK configuration).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Facebook sign-in (Meta for Developers → your app → Settings → Basic: App ID; Advanced: Client token). Read at build time too (app.config.js).
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
